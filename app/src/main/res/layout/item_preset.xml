<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <CheckBox android:id="@+id/playlistCheck"
        android:visibility="gone"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <!-- "Anteprima": non è un vero render del preset (troppo costoso da generare
         per migliaia di preset), ma uno swatch colorato univoco per preset,
         utile a riconoscerli a colpo d'occhio nella lista come nello screenshot. -->
    <View android:id="@+id/previewSwatch"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp"/>

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
        <TextView android:id="@+id/presetTitle"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/presetAuthor"
            android:textSize="13sp"
            android:textColor="#999999"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>

    <ImageButton android:id="@+id/addToPlaylistButton"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_input_add"
        android:layout_width="40dp" android:layout_height="40dp"
        android:contentDescription="@null"/>

    <ImageButton android:id="@+id/favoriteButton"
        android:background="@android:color/transparent"
        android:src="@android:drawable/btn_star_big_off"
        android:layout_width="40dp" android:layout_height="40dp"
        android:contentDescription="@null"/>

</LinearLayout>
