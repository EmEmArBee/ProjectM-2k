<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:background="#000000">

    <!-- GLSurfaceView aggiunto via codice (MainActivity) -->
    <FrameLayout
        android:id="@+id/glContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Logo caricato dall'utente dal menu Impostazioni -->
    <ImageView
        android:id="@+id/logoOverlay"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <!-- Flash di conferma per l'aggiunta/rimozione rapida dai preferiti
         (tieni premuto al centro dello schermo) -->
    <ImageView
        android:id="@+id/favoriteFlash"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:contentDescription="@null"
        android:src="@android:drawable/btn_star_big_on" />

</FrameLayout>
