<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ProjectMOverlay" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.ProjectMOverlay.Settings" parent="Theme.AppCompat.Light.DarkActionBar" />

    <!-- Dialog del preset picker "live": niente dimming di sistema sull'intero
         schermo (backgroundDimEnabled=false), perché la parte di schermo NON
         coperta da questo dialog deve restare una finestra pulita e nitida
         sul visualizer che continua a girare sotto. -->
    <style name="Theme.ProjectMOverlay.TransparentDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="SettingsSectionTitle">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
</resources>
